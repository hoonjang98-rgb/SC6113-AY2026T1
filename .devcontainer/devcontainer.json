{
  "name": "SC6113 Course DApp",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": {
    "python": "python -m pip install -r requirements-chain.txt",
    "node": "npx --yes pnpm@11.19.0 install --frozen-lockfile --ignore-scripts"
  },
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "Flask Course DApp",
      "onAutoForward": "notify"
    }
  }
}
